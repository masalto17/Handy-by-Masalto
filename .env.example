SUPABASE_URL=
SUPABASE_ANON_KEY=
AUTH_REDIRECT_URL=eventradio://login-callback

# LiveKit queda apagado por defecto para que el PTT mock siga funcionando sin credenciales.
LIVEKIT_AUDIO_ENABLED=false
LIVEKIT_URL=

# Estos secretos NO van en la app. Configurarlos como secrets de Supabase Edge Functions:
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# LOCAL_WHISPER_URL=http://host.docker.internal:8787/transcribe
