# Backend (los mismos valores publicos que usa la app).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Identidad del puente dentro del evento.
# Se crea como un participante mas desde el panel de admin ("Radio UHF"),
# y se pega aca su codigo de invitacion.
HANDY_INVITE_CODE=ABCD2345WXYZ
# UUID del canal que se va a puentear (panel de admin -> canal).
HANDY_CHANNEL_ID=00000000-0000-0000-0000-000000000000

# Placa de sonido USB conectada al handy. `arecord -l` y `aplay -l` los listan.
HANDY_AUDIO_IN=plughw:1,0
HANDY_AUDIO_OUT=plughw:1,0

# Accionamiento del PTT.
#   command -> el puente enciende y apaga el transmisor (recomendado)
#   vox     -> lo hace el handy solo al detectar audio
HANDY_PTT_MODE=command
# Ejemplo con libgpiod v2 en una Raspberry Pi 5, GPIO17:
HANDY_PTT_KEY_CMD=gpioset -t0 gpiochip0 17=1
HANDY_PTT_UNKEY_CMD=gpioset -t0 gpiochip0 17=0

# Squelch del receptor: por encima de OPEN hay voz, por debajo de CLOSE no.
# Se ajustan con el radio encendido y nadie hablando (ver README).
HANDY_SQUELCH_OPEN=0.06
HANDY_SQUELCH_CLOSE=0.03
HANDY_SQUELCH_HANG_MS=600

# Tiempos de transmision.
HANDY_LEAD_MS=250
HANDY_TAIL_MS=400
HANDY_MAX_KEY_MS=120000
HANDY_LOCKOUT_MS=3000
